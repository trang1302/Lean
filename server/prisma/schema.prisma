// Mọi bảng mang cột `userId` ngay từ đầu. Nhờ vậy việc thêm auth (đã xong, xem
// docs/features/auth/) chỉ là đổi NGUỒN của `userId` — từ hằng LOCAL_USER_ID
// (đã xóa) sang `req.user.id`, do `requireAuth` gắn — chứ không phải migrate
// lại schema.
//
// Bốn bảng dữ liệu giờ có khóa ngoại thật tới `User`. SQLite chỉ cưỡng chế khóa
// ngoại khi `PRAGMA foreign_keys = ON`; chỗ bật nằm ở src/lib/db.ts, và
// test/lib/schema.test.ts khóa hành vi đó lại. Gỡ pragma = quan hệ dưới đây
// thành trang trí.
//
// `date` luôn là chuỗi "YYYY-MM-DD", KHÔNG BAO GIỜ là DateTime — xem CLAUDE.md.

// Prisma 7: `url` không còn khai ở đây — nằm trong prisma.config.ts.
// Client sinh ra ở src/generated/prisma (gitignore), nối DB qua driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Bắt buộc với `moduleResolution: nodenext` trong tsconfig: mặc định generator
  // sinh barrel re-export THIẾU đuôi (`from './models/BodyLog'`), nodenext từ chối
  // phân giải nên mọi import từ `generated/prisma/models.js` sẽ báo TS2305.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  status       String    @default("active") // "active" | "disabled"
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Nullable + SetNull có chủ đích: xóa một vai trò KHÔNG được xóa theo tài
  // khoản. User `roleId = null` có tập quyền RỖNG → mọi route cần quyền đều
  // 403 (fail closed), nhưng vẫn đăng nhập được để thấy màn "chưa được cấp
  // quyền". Một user mang ĐÚNG MỘT vai trò — nhiều vai trò cộng dồn đẻ ra câu
  // hỏi "hợp hay giao" mà chưa ai cần trả lời.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  sessions  Session[]
  bodyLogs  BodyLog[]
  meals     Meal[]
  goal      Goal?
  reminders Reminder[]
}

model Session {
  id        String   @id // session id do express-session sinh
  userId    String
  data      String // payload phiên đã JSON.stringify
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  emailKey  String // email đã chuẩn hóa
  ip        String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([emailKey, createdAt])
  @@index([ip, createdAt])
}

/// Danh mục vai trò ĐÓNG: sửa bằng seed + review code, không sửa qua UI.
/// Một UI tạo vai trò là một UI để vô tình tạo ra vai trò có `rbac:manage`.
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // "USER" | "ADMIN" | "SYSTEM_ADMIN" — không tiền tố ROLE_
  name        String
  description String?
  sequence    Int      @default(0) // thứ tự hiển thị trên màn Phân quyền
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

/// `resource` + `action` tách rời DÙ `code` đã chứa cả hai: màn Phân quyền
/// nhóm theo `resource`, và parse chuỗi `code` mỗi lần render là chỗ sinh lỗi.
model Permission {
  id       String @id @default(cuid())
  code     String @unique // dạng resource:action, vd "log:view"
  name     String
  resource String // "log" | "goal" | "reminder" | "user" | "rbac"
  action   String // "view" | "manage"
  sequence Int

  roles RolePermission[]

  // Chặn hai hàng cùng (log, view) mà `code` gõ khác nhau (log:view vs logs:view).
  @@unique([resource, action])
}

/// Khóa chính KÉP, không có cột `id` — cùng lối với `@@id([userId, date])` của
/// BodyLog. Ràng buộc "một cặp một lần" do DB cưỡng chế, không do code nhớ.
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model BodyLog {
  userId     String
  date       String
  weightKg   Float?
  waistCm    Float?
  chestCm    Float?
  shoulderCm Float?
  armCm      Float?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  date      String
  slot      String
  name      String
  calories  Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  userId             String   @id
  startWeightKg      Float?
  startDate          String?
  targetWeightKg     Float?
  targetWaistCm      Float?
  targetChestCm      Float?
  targetShoulderCm   Float?
  targetArmCm        Float?
  targetDate         String?
  dailyCalorieTarget Int?
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  timeOfDay String
  enabled   Boolean  @default(false)
  ntfyTopic String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}
