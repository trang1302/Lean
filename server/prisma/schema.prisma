// Mọi bảng mang cột `userId` ngay từ đầu. Nhờ vậy việc thêm auth (giai đoạn A,
// đang làm) chỉ là đổi NGUỒN của `userId` — từ hằng LOCAL_USER_ID sang
// `req.session.userId` — chứ không phải migrate lại schema.
//
// Bốn bảng dữ liệu giờ có khóa ngoại thật tới `User`. SQLite chỉ cưỡng chế khóa
// ngoại khi `PRAGMA foreign_keys = ON`; chỗ bật nằm ở src/lib/db.ts, và
// test/lib/schema.test.ts khóa hành vi đó lại. Gỡ pragma = quan hệ dưới đây
// thành trang trí.
//
// `date` luôn là chuỗi "YYYY-MM-DD", KHÔNG BAO GIỜ là DateTime — xem CLAUDE.md.

// Prisma 7: `url` không còn khai ở đây — nằm trong prisma.config.ts.
// Client sinh ra ở src/generated/prisma (gitignore), nối DB qua driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Bắt buộc với `moduleResolution: nodenext` trong tsconfig: mặc định generator
  // sinh barrel re-export THIẾU đuôi (`from './models/BodyLog'`), nodenext từ chối
  // phân giải nên mọi import từ `generated/prisma/models.js` sẽ báo TS2305.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  status       String    @default("active") // "active" | "disabled"
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions  Session[]
  bodyLogs  BodyLog[]
  meals     Meal[]
  goal      Goal?
  reminders Reminder[]
}

model Session {
  id        String   @id // session id do express-session sinh
  userId    String
  data      String // payload phiên đã JSON.stringify
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  emailKey  String // email đã chuẩn hóa
  ip        String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([emailKey, createdAt])
  @@index([ip, createdAt])
}

model BodyLog {
  userId     String
  date       String
  weightKg   Float?
  waistCm    Float?
  chestCm    Float?
  shoulderCm Float?
  armCm      Float?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  date      String
  slot      String
  name      String
  calories  Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  userId             String   @id
  startWeightKg      Float?
  startDate          String?
  targetWeightKg     Float?
  targetWaistCm      Float?
  targetChestCm      Float?
  targetShoulderCm   Float?
  targetArmCm        Float?
  targetDate         String?
  dailyCalorieTarget Int?
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  timeOfDay String
  enabled   Boolean  @default(false)
  ntfyTopic String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}
