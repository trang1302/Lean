// Mọi bảng mang cột `userId` ngay từ đầu dù bản này chưa có đăng nhập.
// Hiện tại mọi bản ghi dùng hằng LOCAL_USER_ID trong src/shared/constants.ts.
// Thêm auth sau = thay hằng đó bằng user lấy từ session, không phải migrate lại schema.
//
// `date` luôn là chuỗi "YYYY-MM-DD", KHÔNG BAO GIỜ là DateTime — xem CLAUDE.md.

// Prisma 7: `url` không còn khai ở đây — nằm trong prisma.config.ts.
// Client sinh ra ở src/generated/prisma (gitignore), nối DB qua driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Bắt buộc với `moduleResolution: nodenext` trong tsconfig: mặc định generator
  // sinh barrel re-export THIẾU đuôi (`from './models/BodyLog'`), nodenext từ chối
  // phân giải nên mọi import từ `generated/prisma/models.js` sẽ báo TS2305.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model BodyLog {
  userId    String
  date      String
  weightKg  Float?
  waistCm   Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, date])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  date      String
  slot      String
  name      String
  calories  Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model Goal {
  userId             String   @id
  targetWeightKg     Float?
  targetDate         String?
  dailyCalorieTarget Int?
  updatedAt          DateTime @updatedAt
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  timeOfDay String
  enabled   Boolean  @default(false)
  ntfyTopic String?
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
}
